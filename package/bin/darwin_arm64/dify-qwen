# -*- coding: utf-8 -*-
"""QwenWork desktop CLI adapter; tokens are owned exclusively by official difyctl."""
import argparse
import fcntl
import hashlib
import html
import http.server
import json
import os
from pathlib import Path
import secrets
import subprocess
import sys
import threading
import time
import urllib.parse
import webbrowser

VERSION = '0.1.0'
DEFAULT_SERVER = 'https://console-platform-dev.dify.dev'
PACKAGE = Path(__file__).resolve().parents[2]
VENDOR = PACKAGE / 'vendor/darwin_arm64/difyctl'
EXPECTED_SHA256 = 'c9dd3e4ac2e5e5afa7e3ae6c2ab0794994c834438b25791fc8de13c614c13b85'

class ConnectorError(Exception):
    def __init__(self, code, message): self.code, self.message = code, message

def output(data): print(json.dumps(data, ensure_ascii=False), flush=True)
def fail(code, message):
    print(json.dumps({'code':code,'message':message},ensure_ascii=False), file=sys.stderr)
    return 1

def normalize_server(value):
    if not isinstance(value,str) or any(ord(c)<33 for c in value):
        raise ConnectorError('E-0003','请输入合法 HTTPS Dify 控制台地址。')
    u=urllib.parse.urlsplit(value)
    try: port=u.port
    except ValueError: raise ConnectorError('E-0003','地址端口无效。')
    if u.scheme!='https' or not u.hostname or u.username or u.password or u.query or u.fragment:
        raise ConnectorError('E-0003','只接受不含账号、查询参数和片段的 HTTPS 控制台地址。')
    return urllib.parse.urlunsplit(('https',u.netloc,u.path.rstrip('/'),'',''))

def profile():
    root=Path(os.environ.get('QWEN_DIFY_CONFIG_DIR', str(Path.home()/'.config/qwenwork-dify-connector')))
    root.mkdir(parents=True,exist_ok=True,mode=0o700);root.chmod(0o700)
    return root

def saved_server():
    try:return normalize_server(json.loads((profile()/'settings.json').read_text())['server'])
    except (OSError,ValueError,KeyError,ConnectorError):return DEFAULT_SERVER

def save_server(value):
    value=normalize_server(value);root=profile();tmp=root/('settings.'+secrets.token_hex(6)+'.tmp')
    fd=os.open(tmp,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
    with os.fdopen(fd,'w') as f:json.dump({'server':value},f)
    os.replace(tmp,root/'settings.json')

def environment():
    env={k:v for k,v in os.environ.items() if not k.startswith('DIFY_')}
    env['DIFY_CONFIG_DIR']=str(profile()/'difyctl')
    env['DIFY_OUTPUT']='json'
    return env

def verify_binary():
    try:
        with VENDOR.open('rb') as f: digest=hashlib.file_digest(f,'sha256').hexdigest() if hasattr(hashlib,'file_digest') else hashlib.sha256(f.read()).hexdigest()
    except OSError:raise ConnectorError('E-9999','安装包缺少官方 difyctl，请重新安装连接器。')
    if digest!=EXPECTED_SHA256:raise ConnectorError('E-9999','difyctl 校验失败，请重新安装受信任的软件包。')

def invoke(args,timeout=35):
    try:
        p=subprocess.run([str(VENDOR),*args,'--json'],stdin=subprocess.DEVNULL,
                         capture_output=True,env=environment(),timeout=timeout)
    except subprocess.TimeoutExpired:raise ConnectorError('E-0004','Dify 请求超时，请检查网络后重试。')
    except OSError:raise ConnectorError('E-9999','无法启动 difyctl，请检查安装包和执行权限。')
    try:data=json.loads(p.stdout or p.stderr)
    except (ValueError,UnicodeDecodeError):raise ConnectorError('E-0004','Dify CLI 未返回预期 JSON，详细输出已隐藏。')
    return p.returncode,data

def require_success(rc,data):
    if rc==0:return data
    err=data.get('error',{}) if isinstance(data,dict) else {}
    code=err.get('code','');http=err.get('http_status')
    if http==403 or code in ('forbidden','permission_denied') or err.get('server',{}).get('code','').endswith('forbidden'):
        raise ConnectorError('E-0005','Dify 拒绝此操作，请检查当前用户和资源权限。')
    if code=='not_logged_in' or http==401 or rc==4:
        raise ConnectorError('E-0001','Dify 未授权或会话失效，请在连接器页面认证。')
    if rc==2:raise ConnectorError('E-0003','命令参数有误，请先读取对应命令帮助。')
    raise ConnectorError('E-0004','Dify 请求失败，未回传原始错误以避免敏感信息泄露。')

def account():
    if (profile()/'authorization-required').exists():
        raise ConnectorError('E-0001','连接向导未完成，请完成当前 Dify 授权。')
    rc,data=invoke(['describe','account']);data=require_success(rc,data)
    # Only return identity fields; never relay a complete credential/config object.
    if isinstance(data,dict) and isinstance(data.get('data'),dict):data=data['data']
    if isinstance(data,dict) and isinstance(data.get('account'),dict):data=data['account']
    result={k:data[k] for k in ('id','name','email','status') if isinstance(data,dict) and k in data}
    if not result:raise ConnectorError('E-0004','身份接口格式待适配，不能确认已连接。')
    return result

def status():
    try:account();return {'status':'authorized'}
    except ConnectorError as e:
        if e.code=='E-0001':return {'status':'unauthorized'}
        raise

def auth_portal(server=None,no_open=False,limit=900):
    if os.environ.get('QWENWORK_SANDBOX_ID'):
        raise ConnectorError('E-0003','本包仅支持 Mac 桌面，Web Sandbox 请使用平台 OAuth 专用适配。')
    lock=(profile()/'auth.lock').open('a');os.chmod(lock.name,0o600)
    try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        raise ConnectorError('E-0003','已有连接向导正在运行，请完成或关闭该向导。')
    state={'stage':'setup','message':'填写 Dify 控制台地址后发起连接。','server':normalize_server(server) if server else saved_server()}
    csrf=secrets.token_urlsafe(32);endpoint='/'+secrets.token_urlsafe(32)
    stop=threading.Event();guard=threading.Lock()
    def patch(**kw):
        with guard:state.update(kw)
    def worker(target):
        try:
            save_server(target)
            marker=profile()/'authorization-required'
            marker.touch(mode=0o600)
            rc,data=invoke(['login','--server',target,'--no-browser','--no-wait','--no-keyring'])
            data=require_success(rc,data)
            uri=data.get('verification_uri_complete') or data.get('verification_uri')
            code=data.get('user_code')
            if not isinstance(uri,str) or not isinstance(code,str) or not code:
                raise ConnectorError('E-0004','设备授权响应格式不符，未开始轮询。')
            parsed=urllib.parse.urlsplit(uri);base=urllib.parse.urlsplit(target)
            if parsed.scheme!='https' or parsed.netloc!=base.netloc or parsed.username or parsed.password:
                raise ConnectorError('E-0004','验证地址与 Dify 服务端不同源，请由研发核对。')
            expires=max(1,min(int(data.get('expires_in',600)),limit))
            interval=max(5,min(int(data.get('interval',5)),30))
            patch(stage='pending',message='在下面的 Dify 页面完成授权，本页会自动检测。',verification_uri=uri,user_code=code)
            deadline=time.monotonic()+expires
            while not stop.wait(interval) and time.monotonic()<deadline:
                rc,result=invoke(['login','--resume'])
                if rc==0 and result.get('status')=='pending':continue
                require_success(rc,result)
                if stop.is_set():return
                marker.unlink(missing_ok=True)
                try:who=account()
                except ConnectorError:
                    marker.touch(mode=0o600)
                    raise
                patch(stage='authorized',message='已连接，身份接口验证成功。',identity=who)
                return
            raise ConnectorError('E-0002','授权已取消或超时，请重新点击认证。')
        except (ValueError,TypeError):patch(stage='error',message='Dify 返回的授权参数无法识别。')
        except ConnectorError as e:patch(stage='error',message=e.message,error_code=e.code)
        except Exception:patch(stage='error',message='连接异常，请重试；内部信息未输出。')
    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self,*args):pass
        def respond(self,body,kind='application/json; charset=utf-8',code=200):
            raw=body.encode();self.send_response(code)
            self.send_header('Content-Type',kind);self.send_header('Content-Length',str(len(raw)))
            self.send_header('Cache-Control','no-store');self.send_header('X-Content-Type-Options','nosniff')
            self.send_header('Referrer-Policy','no-referrer')
            self.send_header('Content-Security-Policy',"default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'")
            self.end_headers();self.wfile.write(raw)
        def allowed(self):return self.headers.get('Host')==f'127.0.0.1:{self.server.server_port}'
        def do_GET(self):
            if not self.allowed():return self.respond('{}',code=403)
            if self.path==endpoint:
                return self.respond(PAGE.replace('__CSRF__',csrf).replace('__BASE__',endpoint),'text/html; charset=utf-8')
            if self.path==endpoint+'/state':
                with guard:snapshot=dict(state)
                return self.respond(json.dumps(snapshot,ensure_ascii=False))
            self.respond('{}',code=404)
        def do_POST(self):
            expected=f'http://127.0.0.1:{self.server.server_port}'
            if not self.allowed() or self.headers.get('Origin')!=expected or self.headers.get('X-CSRF')!=csrf:
                return self.respond('{}',code=403)
            if self.path not in (endpoint+'/start',endpoint+'/close'):return self.respond('{}',code=404)
            if self.path.endswith('/close'):
                stop.set();return self.respond('{"ok":true}')
            try:
                n=int(self.headers.get('Content-Length',0))
                if not 0<n<=4096:raise ValueError()
                target=normalize_server(json.loads(self.rfile.read(n))['server'])
                with guard:
                    if state['stage']!='setup':return self.respond('{"error":"already_started"}',code=409)
                    state.update(stage='starting',message='正在向 Dify 请求设备授权…')
                threading.Thread(target=worker,args=(target,),daemon=True).start()
                self.respond('{"ok":true}')
            except (ValueError,KeyError,ConnectorError):self.respond('{"error":"invalid_server"}',code=400)
    try:httpd=http.server.ThreadingHTTPServer(('127.0.0.1',0),Handler)
    except OSError:
        lock.close()
        raise ConnectorError('E-0004','无法创建本机连接向导，请检查本机回环端口权限。')
    httpd.timeout=0.5
    url=f'http://127.0.0.1:{httpd.server_port}{endpoint}'
    if no_open:output({'local_setup_url':url})
    elif not webbrowser.open(url):
        httpd.server_close();raise ConnectorError('E-0004','系统浏览器未能打开，请检查默认浏览器设置后重试。')
    started=time.monotonic();authorized_at=None
    try:
        while not stop.is_set() and time.monotonic()-started<limit:
            httpd.handle_request()
            with guard:stage=state['stage']
            if stage=='authorized':
                if authorized_at is None:authorized_at=time.monotonic()
                if time.monotonic()-authorized_at>6:
                    output({'status':'authorized'});return 0
            if stage=='error':
                # Leave the error visible briefly, then release the CLI/client.
                for _ in range(8):httpd.handle_request()
                raise ConnectorError(state.get('error_code','E-0004'),state['message'])
        raise ConnectorError('E-0002','连接向导已取消或超时。')
    finally:stop.set();httpd.server_close();lock.close()

