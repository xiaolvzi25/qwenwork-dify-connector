let s=await r.json();if(!initialized){el('server').value=s.server;initialized=true}el('message').textContent=s.message;el('server').disabled=s.stage!=='setup';el('start').disabled=s.stage!=='setup';if(s.stage==='pending'){el('verify').hidden=false;el('code').textContent=s.user_code;el('link').href=s.verification_uri}if(s.stage==='authorized'){el('verify').hidden=true;el('who').textContent=JSON.stringify(s.identity,null,2);clearInterval(timer)}}catch(e){el('message').textContent='连接向导已关闭或超时，请返回千问办公查看状态。';clearInterval(timer)}}el('start').onclick=async()=>{let r=await fetch(base+'/start',{method:'POST',headers:{'Content-Type':'application/json','X-CSRF':csrf},body:JSON.stringify({server:el('server').value})});if(!r.ok)el('message').textContent='地址无效或请求失败，请检查 HTTPS 地址。';else refresh()};
