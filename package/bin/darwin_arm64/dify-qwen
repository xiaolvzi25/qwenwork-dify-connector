const timer=setInterval(refresh,1500);refresh();</script></html>'''

def main(args):
    if args==['--version']:print(VERSION);return 0
    if not args or args in (['--help'],['-h']):
        output({'name':'dify-qwen','version':VERSION,'platform':'desktop macOS arm64','commands':['auth init [--server URL]','auth show --status','auth logout','identity whoami','cli <official difyctl args>'],'default_server':DEFAULT_SERVER});return 0
    verify_binary()
    if args==['auth','show','--status']:output(status());return 0
    if args==['identity','whoami']:output(account());return 0
    if args==['auth','logout']:
        rc,data=invoke(['logout']);require_success(rc,data);output({'status':'unauthorized','scope':'qwenwork-dify-connector dedicated profile'});return 0
    if args[:2]==['auth','init']:
        ap=argparse.ArgumentParser();ap.add_argument('--server');ap.add_argument('--no-open',action='store_true',help=argparse.SUPPRESS)
        ns=ap.parse_args(args[2:]);return auth_portal(ns.server,ns.no_open)
    if args[0]=='cli' and len(args)>1:
        rest=args[1:]
        if '.' in rest[0]:rest=rest[0].split('.')+rest[1:]
        if (profile()/'authorization-required').exists():
            raise ConnectorError('E-0001','连接向导尚未完成，请先认证。')
        if rest[0] in ('login','logout') or rest[:2] in (['get','config'],['set','config'],['unset','config']) or any(x in ('--verbose','--insecure','--server','--token') or x.startswith(('--token=','--server=','--config')) for x in rest):
            raise ConnectorError('E-0003','认证与配置请用连接器命令；不允许原始配置、令牌或调试输出。')
        rc,data=invoke(rest,timeout=600);require_success(rc,data)
        # JSON business results only. Help and operations remain dynamic.
        output(data);return 0
    raise ConnectorError('E-0003','未知命令，请使用 dify-qwen --help。')

if __name__=='__main__':
    try:raise SystemExit(main(sys.argv[1:]))
    except ConnectorError as e:raise SystemExit(fail(e.code,e.message))
    except KeyboardInterrupt:raise SystemExit(fail('E-0002','操作已取消。'))
    except Exception:raise SystemExit(fail('E-9999','连接器异常；内部详情已隐藏。'))
